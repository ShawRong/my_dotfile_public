CompileFlags:
  Add: 
    - -I/Users/apple/Workspace/new_method_2bit_6.7b/cuda_headers
    - -I/Users/apple/Workspace/new_method_2bit_6.7b/cuda_headers/Common
    - -x
    - cuda
    - --cuda-device-only
    - --cuda-gpu-arch=sm_75
    - -std=c++17
    - -D__CUDACC__
    - -D__NVCC__
    - -D__CUDA_ARCH__=750
    - -DCUDA_VERSION=12060
    - -include
    - cuda_runtime_api.h
    - -include 
    - device_launch_parameters.h
  Remove: 
    - -W*
    - -fcuda-*

Diagnostics:
  Suppress: 
    - unknown-cuda-version
